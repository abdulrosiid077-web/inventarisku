# Salin file ini menjadi .env, lalu sesuaikan data MySQL lokal.
SECRET_KEY=ganti-dengan-random-secret-yang-panjang
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=db_invetaris
DB_USER=root
DB_PASSWORD=
# Opsional: path file CA dari provider MySQL cloud (contoh: certs/ca.pem)
DB_SSL_CA=
# Untuk hosting, aktifkan secure cookie dengan HTTPS:
COOKIE_SECURE=false
FLASK_DEBUG=true
PORT=5000
# Alternatif: isi DATABASE_URL jika provider memberikan connection string.
# DATABASE_URL=mysql+pymysql://username:password@host:port/nama_database
